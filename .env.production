# ============================================================
# PRODUCTION environment
# Firebase Project: cool-car-garage-prod (client ka real data)
# Use this when: EAS build --profile production
#
# INSTRUCTIONS:
# 1. Firebase Console pe naya project banao: cool-car-garage-prod
# 2. Wahan se ye values copy karo aur replace karo:
# ============================================================

EXPO_PUBLIC_FIREBASE_API_KEY=PASTE_PROD_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=cool-car-garage-prod.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cool-car-garage-prod
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=cool-car-garage-prod.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_PROD_SENDER_ID_HERE
EXPO_PUBLIC_FIREBASE_APP_ID=PASTE_PROD_APP_ID_HERE
EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_ENV=production

